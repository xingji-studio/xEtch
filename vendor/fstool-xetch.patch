+    /// Move an entry set while retaining its data allocation and metadata.
+    /// The caller must isolate failures in a disposable transaction layer.
+    pub fn rename_path(
+        &mut self,
+        dev: &mut dyn BlockDevice,
+        old_path: &str,
+        new_path: &str,
+    ) -> Result<()> {
+        self.require_allocation_bitmap()?;
+        self.flush_dir_batches(dev)?;
+        let (old_parent, old_name) = self.split_path_for_create(dev, old_path)?;
+        let (old_pos, set, total) = self
+            .find_entry_in_dir(dev, old_parent, old_name)?
+            .ok_or_else(|| {
+                crate::Error::Io(crate::io::Error::new(
+                    crate::io::ErrorKind::NotFound,
+                    "exfat: rename source does not exist",
+                ))
+            })?;
+        let (new_parent, new_name) = self.split_path_for_create(dev, new_path)?;
+        validate_name(new_name)?;
+        if let Some((pos, _, _)) = self.find_entry_in_dir(dev, new_parent, new_name)? {
+            // The volume's own up-case table identifies case-only renames.
+            if new_parent != old_parent || pos != old_pos {
+                return Err(crate::Error::Io(crate::io::Error::new(
+                    crate::io::ErrorKind::AlreadyExists,
+                    "exfat: rename destination exists",
+                )));
+            }
+        }
+        if set.is_directory {
+            let mut ancestor = new_parent;
+            let mut visited = BTreeSet::new();
+            while ancestor != self.boot.first_cluster_of_root_directory {
+                if ancestor == set.first_cluster || !visited.insert(ancestor) {
+                    return Err(crate::Error::InvalidArgument(
+                        "exfat: cannot move a directory into itself or its descendants".into(),
+                    ));
+                }
+                ancestor = *self.dir_parents.get(&ancestor).ok_or_else(|| {
+                    crate::Error::InvalidImage("exfat: unresolved parent ancestry".into())
+                })?;
+            }
+        }
+        let original = self.read_dir_bytes(dev, old_parent)?;
+        let raw = original
+            .get(old_pos as usize..old_pos as usize + total)
+            .ok_or_else(|| {
+                crate::Error::InvalidImage("exfat: rename source entry exceeds directory".into())
+            })?;
+        let names = format::make_file_entry_set(
+            new_name,
+            set.is_directory,
+            set.secondary_flags,
+            set.first_cluster,
+            set.data_length,
+            set.valid_data_length,
+            set.create_timestamp,
+            self.name_hash_for(new_name),
