<Window x:Class="XEtch.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:XEtch.Windows" Title="xEtch">
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28,0,28,18" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid x:Name="TitleBar" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE7F1;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      <TextBlock Grid.Column="1" Text="xEtch" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="WINDOWS PREVIEW · 0.1" FontSize="11" VerticalAlignment="Center" Margin="18,0,140,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <TextBlock Text="镜像工作台" Style="{ThemeResource TitleTextBlockStyle}"/>
        <TextBlock Text="浏览、整理和编辑磁盘镜像中的文件。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
      <Button x:Name="SaveImageButton" Grid.Column="1" Content="另存镜像" Click="SaveImage_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.AutomationId="SaveImage"/>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="OpenButton" Click="Open_Click" Content="打开镜像…" AutomationProperties.AutomationId="OpenImage"/>
      <Button x:Name="ResumeButton" Grid.Column="1" Click="Resume_Click" Content="恢复编辑会话…"/>
      <Button x:Name="CreateButton" Grid.Column="2" Click="Create_Click" Content="新建镜像…"/>
      <TextBlock x:Name="EngineStatus" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在检查依赖…"/>
    </Grid>
    <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="False" Severity="Error" IsClosable="True"/>
    <Grid Grid.Row="4" ColumnSpacing="20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid RowSpacing="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Spacing="8">
            <TextBlock Text="当前镜像" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ImageName" Text="尚未打开" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ImageDetails" Text="支持 .img 和 .vmdk" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="分区与卷" FontWeight="SemiBold"/>
            <ComboBox x:Name="Partitions" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="Partition_Changed" IsEnabled="False" AutomationProperties.Name="分区与卷"/>
            <TextBlock x:Name="AccessText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="10">
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock x:Name="ChangeCount" Text="0 项会话更改" FontWeight="SemiBold"/>
                <TextBlock Text="编辑会话自动保留，可稍后继续。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Button x:Name="PlanButton" Content="查看更改与会话位置" Click="Plan_Click" HorizontalAlignment="Stretch" IsEnabled="False"/>
            <CheckBox x:Name="ExperimentalToggle" Content="启用 exFAT / ext4 实验写入" Checked="Experimental_Changed" Unchecked="Experimental_Changed" FontSize="12"/>
            <TextBlock Text="另存为新镜像，原始镜像始终保留。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <Grid RowSpacing="0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid x:Name="PathBar" Padding="12" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="Up_Click" ToolTipService.ToolTip="上一级" AutomationProperties.Name="上一级" IsEnabled="False"><FontIcon Glyph="&#xE74A;" FontSize="14"/></Button>
            <TextBox x:Name="DirectoryPath" Grid.Column="1" Text="/" KeyDown="Path_KeyDown" AutomationProperties.Name="镜像内路径" IsEnabled="False"/>
            <Button x:Name="RefreshButton" Grid.Column="2" Click="Refresh_Click" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新" IsEnabled="False"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
          </Grid>
          <CommandBar x:Name="FileCommands" Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" IsEnabled="False">
            <AppBarButton x:Name="ImportButton" Icon="Upload" Label="导入文件" Click="Import_Click" AutomationProperties.AutomationId="ImportFile"/>
            <AppBarButton x:Name="GetButton" Icon="Download" Label="导出文件" Click="Get_Click" IsEnabled="False"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="MkdirButton" Icon="NewFolder" Label="新建文件夹" Click="Mkdir_Click"/>
            <AppBarButton x:Name="RenameButton" Icon="Rename" Label="重命名" Click="Rename_Click" IsEnabled="False"/>
            <AppBarButton x:Name="RemoveButton" Icon="Delete" Label="删除" Click="Remove_Click" IsEnabled="False"/>
          </CommandBar>
          <Grid Grid.Row="2" Padding="24,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <TextBlock Text="名称" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="类型" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="2" Text="大小" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </Grid>
          <ListView x:Name="Files" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="File_Click" SelectionChanged="FileSelection_Changed" Padding="8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="镜像文件列表">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:FileItem">
                <Grid Padding="8,10" ColumnSpacing="10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind Icon}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{x:Bind Kind}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="EmptyState" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" IsHitTestVisible="False" Margin="24">
            <FontIcon Glyph="&#xEDA2;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock x:Name="EmptyTitle" Text="从一份镜像开始" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyDescription" Text="打开 IMG 或 VMDK，即可浏览文件。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="5" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ProgressRing x:Name="BusyRing" IsActive="False" Width="16" Height="16"/>
      <TextBlock x:Name="Status" Grid.Column="1" Text="就绪" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="EntryCount" Grid.Column="2" Text="离线编辑 · 无需挂载" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
  </Grid>
</Window>
